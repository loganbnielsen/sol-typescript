{
  "name": "@sol-fab/retry",
  "version": "0.1.0",
  "description": "Sol's bounded, jittered operation-retry helper for TypeScript -- one shared policy vocabulary with @sol-fab/jobs and the OCaml sol-retry; retries a dependency call in place, never a message or a handler.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sol-fab/sol-typescript.git",
    "directory": "packages/retry"
  },
  "keywords": [
    "sol",
    "retry",
    "backoff",
    "resilience"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
