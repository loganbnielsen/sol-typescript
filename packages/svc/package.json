{
  "name": "@sol-fab/svc",
  "version": "0.3.0",
  "description": "Sol's TypeScript HTTP service lifecycle, outbound peer-authentication helpers, and DEC-063 workload-identity verification for callees -- not a routing framework; wraps Fastify/Express, doesn't replace them.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sol-fab/sol-typescript.git",
    "directory": "packages/svc"
  },
  "keywords": [
    "sol",
    "graceful-shutdown",
    "sigterm"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
