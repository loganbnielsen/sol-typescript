{
  "name": "@sol-fab/svc",
  "version": "0.2.0",
  "description": "Sol's service contract for TypeScript HTTP services -- lifecycle and workload-identity primitives without owning routing or the HTTP framework.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loganbnielsen/sol-typescript.git",
    "directory": "packages/svc"
  },
  "keywords": [
    "sol",
    "graceful-shutdown",
    "sigterm"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
